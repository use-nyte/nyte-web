{
  "name": "@use-nyte/nyte-web",
  "version": "0.0.0",
  "description": "Web code for Nyte.",
  "repository": "https://github.com/use-nyte/nyte-web",
  "license": "Apache-2.0",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "prepare": "husky",
    "start": "PORT=52471 react-router-serve ./dist/server/index.mjs",
    "lint": "pnpm exec lint",
    "lint:fix": "pnpm exec lint --fix",
    "format:check": "pnpm exec format",
    "format": "pnpm exec format --write",
    "typecheck": "react-router typegen && tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@react-router/node": "7.16.0",
    "@react-router/serve": "7.16.0",
    "isbot": "^5.1.40",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "7.16.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.16.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@use-nyte/eslint-config": "2.0.0",
    "@use-nyte/prettier-config": "2.0.0",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  },
  "packageManager": "pnpm@12.18.0"
}
