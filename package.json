{
  "name": "@use-nyte/nyte-web",
  "version": "0.0.0",
  "description": "Web code for Nyte.",
  "repository": "https://github.com/use-nyte/nyte-web",
  "license": "Apache-2.0",
  "scripts": {
    "build": "vite build && pnpm run storybook:build",
    "dev": "vite",
    "preview": "vite preview",
    "prepare": "husky",
    "lint": "pnpm exec lint",
    "lint:fix": "pnpm exec lint --fix",
    "format": "pnpm exec format",
    "format:write": "pnpm exec format --write",
    "typecheck": "tsr generate && tsc --noEmit",
    "docs:build": "tsr generate && typedoc --options typedoc.json",
    "storybook": "storybook dev",
    "storybook:build": "storybook build --output-dir .generated/storybook",
    "test": "vitest run"
  },
  "engines": {
    "node": "26.13.1"
  },
  "packageManager": "pnpm@12.23.0",
  "devDependencies": {
    "@solidjs/testing-library": "0.8.10",
    "@storybook/addon-docs": "10.6.8",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/router-cli": "1.168.0",
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "25.9.1",
    "@use-nyte/eslint-config": "2.1.0",
    "@use-nyte/prettier-config": "2.0.5",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "storybook": "10.6.8",
    "storybook-solidjs-vite": "10.7.4",
    "tailwindcss": "4.3.0",
    "typedoc": "0.28.20",
    "typedoc-docusaurus-theme": "1.4.3",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "6.0.3",
    "vite": "8.1.6",
    "vite-plugin-solid": "2.11.17",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@tanstack/solid-router": "1.170.43",
    "@use-nyte/nyte-ui": "0.0.1",
    "@use-nyte/ui-web": "0.0.1",
    "solid-js": "1.9.20"
  }
}
